# Joule: every setting, with its default. Most can be left out, and the common ones can be set from Setup instead
# (saved in the data volume as settings.json). A value set here wins over Setup; a blank line counts as unset.
# See docs/configuration.md for details. Environment variables use double underscores (App__Demo); appsettings-style
# names use colons (App:Demo).

# --- App -------------------------------------------------------------------------------------------
# Unset: demo until Setup's "Connect my Predbat" switches to live. true pins the demo. false: your real Predbat
# (needs an access key, or an explicit AuthMode=None).
App__Demo=
# AccessKey (default): Joule asks for a key. None: no sign-in at all, only behind your own SSO proxy.
App__AuthMode=AccessKey
# At least 16 characters, e.g. `openssl rand -base64 24`. Required for live AccessKey mode.
App__AccessKey=
# Days a browser stays signed in after a correct key (0 turns remembered sign-in off).
App__SessionDays=30
# auto: the sign-in cookie is Secure when Joule serves HTTPS itself. true: always (set this behind an HTTPS proxy).
App__SecureCookie=auto
# Who may show Joule in a frame. Empty = nobody. For a Home Assistant panel: https://homeassistant.example.com
App__FrameAncestors=
# Local runs only; the container always uses /data in its volume.
App__DataDirectory=./data

# --- Predbat ---------------------------------------------------------------------------------------
# Predbat's web interface (usually port 5052), as reachable from Joule. Read every five minutes.
Predbat__BaseUrl=
# Bearer token, only if your Predbat web interface requires one.
Predbat__AccessToken=
# Entity prefix Predbat uses in Home Assistant.
Predbat__Prefix=predbat
# Live setting changes need this AND your approval (or Auto-mode permission) for each change.
Predbat__WritesEnabled=false
# Predbat MCP (configure mcp_enable/mcp_secret in apps.yaml first). Lets the AI read logs and entity history.
Predbat__McpToken=
# Defaults to the Predbat__BaseUrl host on port 8199 at /mcp.
Predbat__McpUrl=
# Per-call MCP timeout, 1-60 seconds.
Predbat__McpTimeoutSeconds=20
# Which Predbat documentation release the AI cites. Joule downloads it from GitHub (raw.githubusercontent.com).
Predbat__DocumentationRef=v9.3.3

# --- AI ----------------------------------------------------------------------------------------------
# API provider (billed per token by the provider). Choose the model and prices in Joule's AI settings.
Ai__ApiBaseUrl=https://api.openai.com/v1
Ai__ApiKey=

# --- Home Assistant measurements -------------------------------------------------------------------
# Map cumulative energy sensors (kWh/Wh/MWh), not power (W). With only Predbat__BaseUrl set they are read
# through Predbat's copy of Home Assistant state; add BaseUrl and AccessToken to read Home Assistant directly.
HomeAssistant__BaseUrl=
HomeAssistant__AccessToken=
HomeAssistant__TimeZone=Europe/London
HomeAssistant__PollMinutes=5
HomeAssistant__MaxGapMinutes=10
HomeAssistant__Entities__Load=
HomeAssistant__Entities__Pv=
HomeAssistant__Entities__GridImport=
HomeAssistant__Entities__GridExport=
HomeAssistant__Entities__BatteryCharge=
HomeAssistant__Entities__BatteryDischarge=
HomeAssistant__Entities__Ev=
HomeAssistant__Entities__Soc=
HomeAssistant__Entities__ImportTariff=
HomeAssistant__Entities__ExportTariff=
HomeAssistant__Entities__IntelligentSlots=
HomeAssistant__Entities__AlternativeForecast=
# Optional unit override for a sensor that does not declare one, e.g. HomeAssistant__Units__Ev=kWh

# --- Configuration file snapshots ------------------------------------------------------------------
# Mount your Predbat config directory into the container and list the files to version. Empty Root = off.
ConfigFiles__Root=
ConfigFiles__AllowedFiles__0=apps.yaml
ConfigFiles__AllowedFiles__1=
# Let Joule make the AI's apps.yaml edits after you review them (it keeps a copy and puts it back on a problem).
# Also switchable in Setup › Files. Needs write access to the file for the container's user (1654).
ConfigFiles__AllowEdits=
# Seconds Predbat may take to start again after an edit before Joule puts the old file back (default 180).
ConfigFiles__ReloadWaitSeconds=

# --- Container -------------------------------------------------------------------------------------
TZ=Europe/London
# compose.yaml: which image to run (pin a release, e.g. ghcr.io/mrdwilson/joule:1.0.0).
JOULE_IMAGE=ghcr.io/mrdwilson/joule:latest
