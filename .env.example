# Joule: optional settings. You don't need this file. Start Joule, open Setup and use "Connect my Predbat": it saves
# your choices in Joule's data volume. Prefer environment variables? Copy this to .env next to compose.yaml, uncomment
# what you need and run `docker compose up -d`. Anything set here wins over Setup (and shows read-only there).
# Every option, with defaults, is in .env.full.example and docs/configuration.md.

# Leave unset so Setup can switch from the demo to your Predbat. false always runs live; true pins the demo.
# App__Demo=false

# Sign-in key for the dashboard (Setup makes one for you). At least 16 characters: openssl rand -base64 24
# App__AccessKey=

# Predbat's web interface, usually port 5052, as Joule's container reaches it:
#   Predbat's container on the same Docker network:  http://predbat:5052
#   Predbat on this Docker host:                      http://host.docker.internal:5052
#   Home Assistant add-on, or another machine:        http://192.168.1.20:5052  (Home Assistant's or that machine's IP)
# Predbat__BaseUrl=

# Optional: Predbat's mcp_secret, so the AI can read Predbat's logs and Setup can find your meters in apps.yaml.
# Predbat__McpToken=

# Optional: an OpenAI-compatible API key for AI checks (or sign in with ChatGPT; see docs/ai-providers.md).
# Ai__ApiKey=

# Joule never changes Predbat unless this is true and you approve the change.
# Predbat__WritesEnabled=true
